{
  "version": 1,
  "id": "bounded-agent-loop",
  "title": "Bounded agent control loop",
  "purpose": "Separate model action proposals from trusted validation, authorization, execution, checkpointing, approval, and termination.",
  "output": {
    "svg": "curriculum/advanced/05-agentic-ai-architecture-agentcore/assets/bounded-agent-loop.svg",
    "medium": "notebook",
    "alt_text": "An authenticated request creates a bounded run. A model proposes a typed action, which trusted code validates, authorizes, and budgets before a narrow tool executes. The application verifies the result, checkpoints state, and either stops, loops for another proposal, or pauses for a bound approval that returns to validation."
  },
  "canvas": {"width": 2000, "height": 820, "background": "#F7F9FC", "margin": 64, "grid": 8},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 48, "min_layer_gap": 80, "node_padding": {"x": 22, "y": 16}},
  "style": {
    "font_family": "Inter, Arial, sans-serif", "title_color": "#16324F",
    "semantic_colors": {
      "service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"}, "agent": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "data": {"fill": "#E5F7F6", "stroke": "#16A3A5"}, "action": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "operations": {"fill": "#FFFFFF", "stroke": "#52606D"}
    }
  },
  "groups": [],
  "nodes": [
    {"id": "request", "label": "Authenticated request", "type": "operations", "bounds": {"x": 72, "y": 240, "width": 190, "height": 110}, "ports": {"out": {"side": "right", "offset": 0.5}}},
    {"id": "run", "label": "Create bounded run", "type": "service", "bounds": {"x": 310, "y": 240, "width": 190, "height": 110}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "proposal", "label": "Model proposes typed action", "type": "agent", "bounds": {"x": 548, "y": 240, "width": 190, "height": 110}, "ports": {"in": {"side": "left", "offset": 0.5}, "loop": {"side": "top", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "validate", "label": "Validate, authorize, reserve budget", "type": "action", "bounds": {"x": 786, "y": 230, "width": 190, "height": 130}, "ports": {"in": {"side": "left", "offset": 0.5}, "approval": {"side": "bottom", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "tool", "label": "Execute narrow tool", "type": "service", "bounds": {"x": 1024, "y": 240, "width": 190, "height": 110}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "checkpoint", "label": "Verify, reconcile, checkpoint", "type": "data", "bounds": {"x": 1262, "y": 230, "width": 190, "height": 130}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "stop", "label": "Trusted stop condition", "type": "action", "bounds": {"x": 1500, "y": 240, "width": 190, "height": 110}, "ports": {"in": {"side": "left", "offset": 0.5}, "loop": {"side": "top", "offset": 0.35}, "approval": {"side": "bottom", "offset": 0.5}, "done": {"side": "right", "offset": 0.5}}},
    {"id": "terminal", "label": "Application-owned terminal state", "type": "service", "bounds": {"x": 1738, "y": 230, "width": 190, "height": 130}, "ports": {"in": {"side": "left", "offset": 0.5}}},
    {"id": "approval", "label": "Pause for bound approval", "type": "action", "bounds": {"x": 1430, "y": 520, "width": 240, "height": 110}, "ports": {"in": {"side": "top", "offset": 0.5}, "out": {"side": "left", "offset": 0.5}}}
  ],
  "edges": [
