    {"id": "validate_tool", "from": {"node": "validate", "port": "out"}, "to": {"node": "tool", "port": "in"}, "kind": "primary", "route": [[976, 295], [1024, 295]]},
    {"id": "tool_checkpoint", "from": {"node": "tool", "port": "out"}, "to": {"node": "checkpoint", "port": "in"}, "kind": "primary", "route": [[1214, 295], [1262, 295]]},
    {"id": "checkpoint_stop", "from": {"node": "checkpoint", "port": "out"}, "to": {"node": "stop", "port": "in"}, "kind": "primary", "route": [[1452, 295], [1500, 295]]},
