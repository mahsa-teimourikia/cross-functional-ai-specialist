    {"id": "generation_validation", "from": {"node": "generator", "port": "out"}, "to": {"node": "validator", "port": "generation"}, "kind": "primary", "route": [[1214, 495], [1238, 495], [1238, 418], [1262, 418]]},
    {"id": "validation_outcome", "from": {"node": "validator", "port": "out"}, "to": {"node": "outcome", "port": "in"}, "kind": "primary", "route": [[1472, 390], [1560, 390]]}
  ],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "min_connector_clearance": 12, "verify_port_attachment": true, "verify_contrast": true}
}
