    {"id": "boundary_application", "from": {"node": "boundary", "port": "out"}, "to": {"node": "application", "port": "boundary"}, "kind": "primary", "route": [[500, 280], [650, 280], [650, 328], [786, 328]]},
    {"id": "principal_application", "from": {"node": "principal", "port": "out"}, "to": {"node": "application", "port": "principal"}, "kind": "primary", "route": [[500, 520], [650, 520], [650, 392], [786, 392]]},
    {"id": "application_retrieval", "from": {"node": "application", "port": "retrieval"}, "to": {"node": "retriever", "port": "in"}, "kind": "primary", "route": [[976, 328], [992, 328], [992, 275], [1024, 275]]},
    {"id": "application_generation", "from": {"node": "application", "port": "generation"}, "to": {"node": "generator", "port": "in"}, "kind": "primary", "route": [[976, 392], [992, 392], [992, 495], [1024, 495]]},
